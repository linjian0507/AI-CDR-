<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>AIVectorInstaller</RootNamespace>
    <AssemblyName>AIVectorInstaller</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Platforms>AnyCPU</Platforms>
    <Prefer32Bit>false</Prefer32Bit>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyTitle>AI矢量助手安装程序</AssemblyTitle>
    <AssemblyVersion>2.3.5.0</AssemblyVersion>
    <FileVersion>2.3.5.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <EmbeddedResource Include="payload.zip">
      <LogicalName>AIVectorInstaller.Payload.zip</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
